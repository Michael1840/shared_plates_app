      "text": "7 \u00b7 Dark mode",
      "kind": "title1",
      "maxW": 1330
    },
    "s1": {
      "x": 2820,
      "y": 0,
      "w": 360,
      "fill": "orange",
      "text": "Onboarding: one tap to sign in, then 3 short steps (name, tastes, friends), each skippable. Units default to metric from the device locale. Notifications and contacts are only asked for later, when they clearly help (e.g. the first time someone saves your recipe)."
    },
    "s2": {
      "x": 1410,
      "y": 3316,
      "w": 360,
      "fill": "orange",
      "text": "Cook mode: big type for reading at arm's length, the screen stays on, timers come from the step text, and the left/right halves of the screen are huge Back/Next targets for messy hands. Finishing a cook tells the creator someone made their food, which gives creators a reward without needing comments."
    },
    "s3": {
      "x": 1880,
      "y": 6596,
      "w": 360,
      "fill": "orange",
      "text": "Creating: one page, not a wizard. Type or paste ingredients and method as plain lines; each line is parsed into amount + unit + food and matched to the food library. Unmatched lines are kept as written (they just don't count towards nutrition). Only title, 1 ingredient and 1 step are required; everything autosaves as a draft."
    },
    "s4": {
      "x": 940,
      "y": 14646,
      "w": 360,
      "fill": "orange",
      "text": "Dark palette: background #1C1613, cards #2B221C, raised #3A2F28, text #F6F1EA, secondary text #CDBFB4, accent text #F7B79B. Main buttons stay paprika #C4421D with white text. Selected chips: #4A2A1E fill, #E0683F outline. Photos and illustrated covers are unchanged."
    },
    "t8": {
      "x": 4150,
      "y": 1250,
      "text": "Earlier directions (Home now mixes both)",
      "kind": "title1",
      "maxW": 860
    }
  },
